<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MimesisPlayerEnhancement.Tests</RootNamespace>
    <AssemblyName>MimesisPlayerEnhancement.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin/</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Reflection.MetadataLoadContext" />
    <PackageReference Include="HarmonyX" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MimesisPlayerEnhancement\MimesisPlayerEnhancement.csproj">
      <SetTargetFramework>TargetFramework=netstandard2.1</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

  <!-- MelonLoader stays Private=false — loading it into vstest hangs the host. -->
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderPath)/MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Private=true so discovery/runtime can load live game types; AssemblyResolve covers transitive Managed deps. -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameAssemblyPath)/Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine" Condition="Exists('$(GameAssemblyPath)/UnityEngine.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule" Condition="Exists('$(GameAssemblyPath)/UnityEngine.CoreModule.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.UI" Condition="Exists('$(GameAssemblyPath)/UnityEngine.UI.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.UI.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule" Condition="Exists('$(GameAssemblyPath)/UnityEngine.UIModule.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.UIModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule" Condition="Exists('$(GameAssemblyPath)/UnityEngine.ImageConversionModule.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule" Condition="Exists('$(GameAssemblyPath)/UnityEngine.AudioModule.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.AudioModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule" Condition="Exists('$(GameAssemblyPath)/UnityEngine.UnityWebRequestModule.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.UnityWebRequestModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule" Condition="Exists('$(GameAssemblyPath)/UnityEngine.UnityWebRequestAudioModule.dll')">
      <HintPath>$(GameAssemblyPath)/UnityEngine.UnityWebRequestAudioModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UniTask" Condition="Exists('$(GameAssemblyPath)/UniTask.dll')">
      <HintPath>$(GameAssemblyPath)/UniTask.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="FishNet.Runtime" Condition="Exists('$(GameAssemblyPath)/FishNet.Runtime.dll')">
      <HintPath>$(GameAssemblyPath)/FishNet.Runtime.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="com.rlabrecque.steamworks.net" Condition="Exists('$(GameAssemblyPath)/com.rlabrecque.steamworks.net.dll')">
      <HintPath>$(GameAssemblyPath)/com.rlabrecque.steamworks.net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
